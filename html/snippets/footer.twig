<div class="footer-row-1">
	<div class="container">
		<div class="shopping-banners">
			<div class="row">
				{% for i in 1..4 %}
					{% set shoppingBannerTitle = theme.settings["shopping_banner_title_" ~ i] %}
					{% set shoppingBannerSubTitle = theme.settings["shopping_banner_sub_title_" ~ i] %}
					{% set shoppingBannerImage = theme.settings["shopping_banner_image_" ~ i] %}
					{% set shoppingBannerLink = theme.settings["shopping_banner_link_" ~ i] %}
					{% if shoppingBannerTitle %}
						<div class="col-md-6 col-lg-3 mb-5 mb-lg-0">
							{% if shoppingBannerLink %}
							<a href="{{ shoppingBannerLink }}" class="shopping-banner">
							{% else %}
							<div class="shopping-banner">
							{% endif %}
								<div class="shopping-banner-img">
									<img src="{{ themeAsset(shoppingBannerImage) }}" alt="">
								</div>
								<div class="shopping-banner-title">{{ shoppingBannerTitle }}</div>
								<div class="shopping-banner-sub-title">{{ shoppingBannerSubTitle }}</div>
							{% if shoppingBannerLink %}
							</a>
							{% else %}
							</div>
							{% endif %}
						</div>
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</div>
</div>
<div class="footer-row-2">
	<div class="container">
		<div class="row">
			<div class="col-md-9">
				{% if theme.settings.footer_links | spaceless | length > 0 %}
					<div class="footer-menu-container" data-menu-type="{{ theme.settings.footer_menu_type }}">
						{{ theme.settings.footer_links | raw }}
					</div>
				{% endif %}
			</div>
			<div class="col-md-3">
				<div class="footer-text">
					Bizi Takip Edin!
				</div>
				<div class="footer-social">
					{% if theme.settings.facebook %}
						<div>
							<a class="footer-social-facebook" href="{{ theme.settings.facebook }}" target="_blank">
								<i class="fab fa-facebook-f"></i>
							</a>
						</div>
					{% endif %}
					{% if theme.settings.instagram %}
						<div>
							<a class="footer-social-instagram" href="{{ theme.settings.instagram }}" target="_blank">
								<i class="fab fa-instagram"></i>
							</a>
						</div>
					{% endif %}
					{% if theme.settings.youtube %}
						<div>
							<a class="footer-social-youtube" href="{{ theme.settings.youtube }}" target="_blank">
								<i class="fab fa-youtube"></i>
							</a>
						</div>
					{% endif %}
				</div>
		</br>
            <a href="https://etbis.eticaret.gov.tr/sitedogrulama/7875653361227570" target="_blank"><img style=" width: 120px; height: 120px;" src="data:image/jpeg;base64, ">
			</a></div>
        
        </div>
	</div>
</div>
<div class="footer-row-3">
	<div class="container">
		<div class="footer-copyright">
			{% if theme.settings.copyright %}
				<div class="copyright">{{ theme.settings.copyright | raw }}</div>
			{% endif %}
			<img src="{{ themeAsset('images/footer-cart.png') }}" alt="">
		</div>
	</div>
</div>
<div id="scroll-top">
	<img src="{{ themeAsset('images/scroll-top.svg') }}" alt="">
</div>