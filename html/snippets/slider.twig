{% if slider.items | length > 0 %}
    <script type="text/javascript">
        $(function() {
            $('.slider-{{ slider.id }}').not('.slick-initialized').slick({
				slidesToShow: 1,
				slidesToScroll: 1,
                infinite: false,
                autoplay : false,
                autoplaySpeed : {{ slider.settings.autoStartTime }},
                arrows : false,
				dots: true,
				swipe: true,
				appendDots: $('.slider-{{ slider.id }}'),
				customPaging: function(slider, i) {
					var thumb = $(slider.$slides[i]).find('img').attr('src');
					console.log(thumb);
					return '<img src="'+thumb+'" >';
				},
                speed : {{ slider.settings.effectTime }},
                fade : {{ slider.settings.sliderEffect == 'fade' ? 'true' : 'false' }},
                prevArrow : '<button type="button" class="slick-prev" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>',
				nextArrow : '<button type="button" class="slick-next" aria-label="Next"><i class="fas fa-chevron-right"></i></button>',
				responsive: [
					{
						breakpoint: 991,
						settings: {
							dots: true,
							swipe: true
						}
					}
				]
			});
        });
    </script>
    <style type="text/css">
        .slider-{{ slider.id }} .slick-slide {position: relative;}
        .slider-{{ slider.id }} .slick-prev, .slider-{{ slider.id }} .slick-next {opacity: {{ slider.settings.previousNextOpacity / 100 }};}
        .slider-{{ slider.id }} .slick-prev i, .slider-{{ slider.id }} .slick-next i {width:{{ slider.settings.previousNextSize }}px; height:{{ slider.settings.previousNextSize }}px;font-size:{{ slider.settings.previousNextSize }}px;color:{{ slider.settings.previousNextColor }};  }
        .slider-{{ slider.id }} .slider-description {font-family: {{ slider.settings.definitionFontFamilySelect }};color: {{ slider.settings.definitionFontColorSelect }};font-size: {{ slider.settings.definitionFontFamilySize }}px;background-color: {{ slider.settings.definitionBackgroundColor }};}
        .slider-{{ slider.id }} .slider-description.top {top: {{ slider.settings.definitionVerticalSpace }}px;}
        .slider-{{ slider.id }} .slider-description.bottom {bottom: {{ slider.settings.definitionVerticalSpace }}px;}
        .slider-{{ slider.id }} .slider-description.left {left: {{ slider.settings.definitionHorizontalSpace }}px;}
        .slider-{{ slider.id }} .slider-description.right {right: {{ slider.settings.definitionHorizontalSpace }}px;}
        .slider-{{ slider.id }} .slick-dots li button {background-color: {{ slider.settings.bulletPassiveColor }};color: {{ slider.settings.bulletPassiveFontColor }};width: 1.6rem;line-height: 1.6rem;font-size: 1rem;}
        .slider-{{ slider.id }} .slick-dots li.slick-active button {background-color: {{ slider.settings.bulletActiveColor }};color: {{ slider.settings.bulletActiveFontColor }};}
        {% if not slider.settings.paginationNumeric %}.slider-{{ slider.id }} .slick-dots button {text-indent:-9999px;}{% endif %}

        @media (max-width:767px) {
            .slider-description {display: none;}
        }
        @media (max-width:991px) {
            .slider-{{ slider.id }} .slider-description {font-size: {{ (slider.settings.definitionFontFamilySize / 1.50) | round }}px;}
        }
    </style>
    <div class="slider-{{ slider.id }}">
        {% for item in slider.items %}
            <div>
                <a href="{{ item.link }}"{% if item.target %} target="_blank"{% endif %} rel="noopener">
                    <div class="slider-image"><img src="{{ item.imageUrl }}" alt="{{ item.description }}"/></div>
                    {% if slider.settings.definition and item.description %}
                        <span class="slider-description {{ slider.settings.definitionVerticalPosition }} {{ slider.settings.definitionHorizontalPosition }}">
                            {{ item.description }}
                        </span>
                    {% endif %}
                </a>
            </div>
        {% endfor %}
	</div>
{% endif %}